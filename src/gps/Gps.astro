---
// Ship GPS: pick where you are and where you're going, and see the walking route, deck by deck.
// The route is computed in the browser (lib/rotas.ts) from rotas.json (generated by plantas/tools/rotas.py).
import Icon from './Icon.astro';
import ShipProfile from './ShipProfile.astro';
import { TEXTOS, type Lang } from './i18n/strings';

interface Props {
  /** Interface language: 'en' (default) or 'pt' (Brazilian Portuguese). */
  lang?: Lang;
  /** Where rotas.json and deck-N.svg are served from. */
  base?: string;
}
const { lang = 'en', base = '/plantas/' } = Astro.props;
const t = TEXTOS[lang];
---

<div class="gps" data-gps data-lang={lang} data-base={base}>
  <div class="card gps-form">
    <div class="gps-pontos">
      <button type="button" class="gps-ponto vazio" data-gps-campo="de">
        <span class="gps-letra">A</span>
        <span class="gps-ponto-txt">
          <small>{t.ondeEsta}</small>
          <b>{t.escolherPartida}</b>
        </span>
        <Icon name="chevron" class="icon dir" />
      </button>
      <button type="button" class="gps-ponto vazio" data-gps-campo="para">
        <span class="gps-letra b">B</span>
        <span class="gps-ponto-txt">
          <small>{t.paraOnde}</small>
          <b>{t.escolherDestino}</b>
        </span>
        <Icon name="chevron" class="icon dir" />
      </button>
      <button type="button" class="gps-trocar" data-gps-trocar aria-label={t.inverter}>
        <Icon name="swap" class="icon gira" />
      </button>
    </div>
    <div class="gps-favs" role="group" aria-labelledby="gps-favs-lbl">
      <div class="gps-favs-topo">
        <span class="lbl" id="gps-favs-lbl"><Icon name="star" /> {t.favoritos}</span>
        <button type="button" class="gps-link" data-gps-favs-abrir hidden>{t.editar}</button>
      </div>
      <div class="gps-favs-lista" data-gps-favs-lista></div>
      <p class="small muted gps-favs-nota" role="status" aria-live="polite"></p>
    </div>
    <div class="gps-atalhos" role="group" aria-label={t.maisProcurados}>
      <span class="lbl">{t.irPara}</span>
      {t.atalhos.map((a) => <button type="button" class="gps-chip" data-gps-atalho={a.lugar}>{a.rotulo}</button>)}
    </div>
    <p class="small gps-msg" role="status" aria-live="polite"></p>
  </div>

  <div class="gps-resultado" hidden>
    <div class="card gps-resumo">
      <div class="gps-numeros">
        <b class="gps-tempo"></b>
        <span class="gps-detalhe"></span>
      </div>
      <ShipProfile lang={lang}>
        <g class="pf-rota"></g>
      </ShipProfile>
      <p class="small muted gps-legenda">{t.legendaPerfil}</p>
    </div>

    <ol class="gps-passos"></ol>

    <p class="small muted gps-aviso">{t.aviso}</p>
  </div>

  <dialog class="lugar-sheet gps-picker" aria-labelledby="gps-picker-titulo">
    <div class="ls-topo">
      <span class="gps-letra"></span>
      <div class="ls-titulo">
        <h3 id="gps-picker-titulo"></h3>
      </div>
      <form method="dialog"><button class="ls-fechar" aria-label={t.fechar}><Icon name="close" /></button></form>
    </div>
    <label class="busca gps-busca">
      <Icon name="search" />
      <input class="input" type="search" autocomplete="off" enterkeyhint="search" placeholder={t.buscaPlaceholder} aria-label={t.buscaAria} />
    </label>
    <div class="gps-lista"></div>
  </dialog>

  <dialog class="lugar-sheet gps-favs-dlg" aria-labelledby="gps-favs-titulo">
    <div class="ls-topo">
      <span class="ls-ico lugar-cor gps-fav-ico"><Icon name="star" /></span>
      <div class="ls-titulo">
        <h3 id="gps-favs-titulo">{t.favoritos}</h3>
      </div>
      <form method="dialog"><button class="ls-fechar" aria-label={t.fechar}><Icon name="close" /></button></form>
    </div>
    <div class="gps-favs-corpo">
      <p class="small muted gps-favs-intro">{t.favsIntro}</p>
      <ul class="gps-favs-itens"></ul>
      <form class="card gps-fav-form" novalidate>
        <h4 class="gps-fav-form-titulo">{t.novoFavorito}</h4>
        <label class="lbl" for="gps-fav-nome">{t.nome}</label>
        <input class="input" id="gps-fav-nome" name="nome" type="text" maxlength="30" autocomplete="off" autocapitalize="words" enterkeyhint="next" placeholder={t.nomePlaceholder} />
        <label class="lbl" for="gps-fav-ponto">{t.cabineOuLugar}</label>
        <button type="button" class="gps-ponto vazio" id="gps-fav-ponto" data-gps-fav-ponto>
          <span class="gps-ponto-txt">
            <small>{t.toqueEscolher}</small>
            <b>{t.digiteCabine}</b>
          </span>
          <Icon name="chevron" class="icon dir" />
        </button>
        <p class="small gps-msg gps-fav-erro" role="alert"></p>
        <div class="btn-row gps-fav-botoes">
          <button type="button" class="btn btn-ghost" data-gps-fav-cancelar hidden>{t.cancelar}</button>
          <button type="submit" class="btn btn-primary"><Icon name="check" /> <span>{t.salvar}</span></button>
        </div>
      </form>
      <button type="button" class="btn btn-ghost btn-block gps-fav-enviar" data-gps-favs-enviar hidden>
        <Icon name="share" /> {t.enviarFavs}
      </button>
      <p class="small muted gps-fav-enviar-nota" hidden>{t.enviarNota}</p>
    </div>
  </dialog>

  <dialog class="planta-real gps-zoom" aria-labelledby="gps-zoom-titulo">
    <div class="pr-topo">
      <div class="pr-titulo">
        <span class="lbl">{t.rotaProaCima}</span>
        <h3 id="gps-zoom-titulo">Deck</h3>
      </div>
      <form method="dialog"><button class="ls-fechar" aria-label={t.fechar}><Icon name="close" /></button></form>
    </div>
    <div class="pr-area">
      <div class="pr-svg"></div>
    </div>
    <div class="pr-base">
      <div class="pr-zoom" role="group" aria-label="Zoom">
        <button type="button" data-gps-zoom="-1" aria-label={t.diminuir}><Icon name="minus" /></button>
        <button type="button" data-gps-zoom="0">{t.verRota}</button>
        <button type="button" data-gps-zoom="1" aria-label={t.aumentar}><Icon name="plus" /></button>
      </div>
      <p class="pr-cred">{t.zoomDica}</p>
    </div>
  </dialog>
</div>

<script>
  import { svg as icone, ICONS } from './lib/icons';
  import { criarZoom } from './lib/zoom';
  import { planejar, cabine as cabineRota, lugar, ponte, DECKS, type DadosRotas, type Ponto, type Rota, type Trecho } from './lib/rotas';
  import { TEXTOS, ICONES_CAT, type Lang } from './i18n/strings';

  type Campo = 'de' | 'para';
  /** Para que o seletor de lugar foi aberto: a partida, o destino ou um favorito. */
  type Escolha = Campo | 'fav';
  /** Favorito: nome dado pela pessoa (n), chave do ponto (k) e, para mostrar antes de carregar o mapa, nome do ponto (p) e deck (d). */
  type Fav = { n: string; k: string; p: string; d: number };
  type Andar = Extract<Trecho, { tipo: 'andar' }>;

  const root = document.querySelector<HTMLElement>('[data-gps]');
  if (root) {
    const lang = (root.dataset.lang === 'pt' ? 'pt' : 'en') as Lang;
    const T = TEXTOS[lang];
    const BASE = root.dataset.base || '/plantas/';
    const cats: Record<string, { nome: string; icone: string }> = Object.fromEntries(
      Object.entries(T.cats).map(([k, nome]) => [k, { nome, icone: ICONES_CAT[k as keyof typeof ICONES_CAT] }]),
    );
    /** Nomes e textos das plantas (em português) traduzidos: carregado só fora do português. */
    let traducao: Record<string, string> | null = null;
    const tr = (s: string) => (traducao && traducao[s]) || s;
    const ORDEM = ['comida', 'bar', 'show', 'piscina', 'esporte', 'criancas', 'loja', 'servico'];
    const MINHA = 'gps-cabine';
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const msg = $('.gps-msg');
    const resultado = $('.gps-resultado');
    const passos = $('.gps-passos');
    const picker = $<HTMLDialogElement>('.gps-picker');
    const busca = picker.querySelector('input')!;
    const lista = picker.querySelector<HTMLElement>('.gps-lista')!;

    let dados: DadosRotas | null = null;
    const pontos: Record<Campo, Ponto | null> = { de: null, para: null };
    let rota: Rota | null = null;
    let campoAberto: Escolha = 'de';

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const semAcento = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const guardada = () => {
      try {
        return Number(localStorage.getItem(MINHA)) || 0;
      } catch {
        return 0;
      }
    };

    // ---- Favoritos (salvos no celular) ----
    const FAVS = 'gps-favoritos';
    const MAX_FAVS = 40;
    const lerFavs = (): Fav[] => {
      try {
        const v = JSON.parse(localStorage.getItem(FAVS) ?? '[]');
        return Array.isArray(v)
          ? v.filter((f) => f && typeof f.n === 'string' && typeof f.k === 'string').map((f) => ({ n: f.n, k: f.k, p: String(f.p ?? ''), d: Number(f.d) || 0 }))
          : [];
      } catch {
        return [];
      }
    };
    let favs = lerFavs();
    const salvarFavs = () => {
      try {
        localStorage.setItem(FAVS, JSON.stringify(favs));
      } catch {}
      mostrarFavs();
    };
    const limparNome = (s: string) => s.replace(/\s+/g, ' ').trim().slice(0, 30);
    /** Primeiro favorito que aponta para este ponto (para mostrar o nome dado pela pessoa). */
    const favDe = (p: Ponto | null) => (p ? favs.find((f) => f.k === p.chave) : undefined);
    /** "10123" para cabines; o nome do lugar para os outros. */
    const ondeFav = (f: Fav) => (/^c\d+$/.test(f.k) ? T.cabine(f.k.slice(1)) : f.p);

    // ---- Dados e plantas ----
    let carga: Promise<DadosRotas | null> | null = null;
    const carregar = () =>
      (carga ??= Promise.all([
        fetch(BASE + 'rotas.json').then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json() as Promise<DadosRotas>;
        }),
        lang === 'pt' ? null : import('./i18n/places.en.json').then((m) => m.default as Record<string, string>),
      ])
        .then(([d, mapa]) => {
          if (mapa) {
            traducao = mapa;
            for (const l of d.lugares) {
              l.o = l.n; // o nome original continua valendo na busca
              l.n = tr(l.n);
              l.t = tr(l.t);
            }
          }
          return (dados = d);
        })
        .catch(() => {
          carga = null;
          msg.textContent = T.erroDados;
          return null;
        }));

    const plantas = new Map<number, Promise<string>>();
    const planta = (n: number) => {
      let p = plantas.get(n);
      if (!p) {
        p = fetch(`${BASE}deck-${n}.svg`)
          .then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            return r.text();
          })
          .then(traduzirPlanta);
        p.catch(() => plantas.delete(n));
        plantas.set(n, p);
      }
      return p;
    };

    /** Troca os rótulos e os textos da planta pela tradução (fora do português). */
    function traduzirPlanta(txt: string) {
      if (!traducao) return txt;
      const doc = new DOMParser().parseFromString(txt, 'image/svg+xml');
      const svg = doc.documentElement;
      if (svg.nodeName !== 'svg') return txt;
      svg.querySelectorAll('text').forEach((el) => {
        const v = el.textContent ?? '';
        if (traducao![v]) el.textContent = traducao![v];
      });
      svg.querySelectorAll('[data-n], [data-t]').forEach((el) => {
        for (const a of ['data-n', 'data-t']) {
          const v = el.getAttribute(a);
          if (v && traducao![v]) el.setAttribute(a, traducao![v]);
        }
      });
      return new XMLSerializer().serializeToString(svg);
    }

    const cabine = (d: DadosRotas, num: number) => {
      const c = cabineRota(d, num);
      if (c) c.nome = T.cabine(num);
      return c;
    };

    const porChave = (chave: string): Ponto | null => {
      if (!dados) return null;
      const c = chave.match(/^c(\d+)$/);
      if (c) return cabine(dados, Number(c[1]));
      const l = dados.lugares.find((x) => x.ids.includes(chave));
      return l ? lugar(l) : null;
    };

    // ---- Formulário ----
    const mostrarCampo = (campo: Campo) => {
      const b = $(`[data-gps-campo="${campo}"]`);
      const p = pontos[campo];
      b.classList.toggle('vazio', !p);
      const f = favDe(p);
      b.querySelector('b')!.textContent = p ? (f ? `${f.n} · ${p.nome}` : p.nome) : campo === 'de' ? T.escolherPartida : T.escolherDestino;
      b.querySelector('small')!.textContent = (campo === 'de' ? T.ondeEsta : T.paraOnde) + (p ? ` · deck ${p.deck}` : '');
    };

    const definir = (campo: Campo, p: Ponto | null) => {
      pontos[campo] = p;
      if (p?.cabine) {
        try {
          localStorage.setItem(MINHA, String(p.cabine));
        } catch {}
      }
      mostrarCampo(campo);
      calcular();
    };

    const tempo = (seg: number) => (seg < 50 ? T.menosDe1 : T.min(Math.max(1, Math.round(seg / 60))));
    const plural = T.andares;

    function calcular() {
      const { de, para } = pontos;
      const u = new URL(location.href);
      for (const k of ['de', 'para'] as const) pontos[k] ? u.searchParams.set(k, pontos[k]!.chave) : u.searchParams.delete(k);
      history.replaceState(null, '', u);
      rota = null;
      resultado.hidden = true;
      msg.textContent = '';
      if (!dados || !de || !para) return;
      if (de.chave === para.chave) {
        msg.textContent = T.mesmoLugar;
        return;
      }
      rota = planejar(dados, de, para);
      if (!rota || !rota.trechos.length) {
        rota = null;
        msg.textContent = T.semCaminho;
        return;
      }
      mostrarRota();
    }

    // ---- Resultado ----
    const ATE = (p: Ponto) => {
      const f = favDe(p);
      const onde = p.cabine ? T.ateCabine(p.cabine) : `<b>${esc(p.nome)}</b>`;
      return f ? `${onde} (${esc(f.n)})` : onde;
    };

    function mostrarRota() {
      if (!rota || !dados) return;
      const { de, para } = pontos as Record<Campo, Ponto>;
      const troca = rota.trechos.filter((t) => t.tipo === 'andares');
      $('.gps-tempo').textContent = tempo(rota.seg);
      const n = Math.abs(DECKS.indexOf(de.deck) - DECKS.indexOf(para.deck));
      $('.gps-detalhe').textContent =
        `${T.aPe(Math.max(5, Math.round(rota.metros / 5) * 5))} · ` +
        (n ? T.sobeDesce(para.deck > de.deck, plural(n), de.deck, para.deck) : T.tudoNoDeck(de.deck));

      const andando = rota.trechos.filter((t): t is Andar => t.tipo === 'andar');
      const html = rota.trechos.map((t) => {
        if (t.tipo === 'andares') {
          const sobe = t.ate > t.de;
          const pula17 = Math.min(t.de, t.ate) < 17 && Math.max(t.de, t.ate) > 17 ? T.semDeck17 : '';
          const como = t.escada ? T.pertinho : T.deElevador;
          return `<li class="card gps-passo gps-troca">
            <div class="gps-passo-cab">
              <span class="gps-passo-ico">${icone('elevator')}</span>
              <div>
                <span class="deck-num">Deck ${t.de} → ${t.ate}</span>
                <h3>${T.subaDesca(sobe, plural(t.andares), t.ate)}</h3>
                <p class="small">${como}${pula17}</p>
              </div>
            </div>
          </li>`;
        }
        const i = andando.indexOf(t);
        const m = Math.round(t.metros / 5) * 5;
        const rumo = t.sentido === 'proa' ? T.rumoProa : t.sentido === 'popa' ? T.rumoPopa : '';
        const titulo = t.metros < 15 ? T.logoAli : T.ande(m, rumo);
        const alvo = t.ate === 'destino' ? T.sigaAte(ATE(para)) : T.sigaAteBanco(T.bancos[t.ate]);
        const dica = t.sentido && dados!.decks[t.deck].cab.length > 300 ? T.dicaCabines : '';
        return `<li class="card gps-passo">
          <div class="gps-passo-cab">
            <span class="gps-passo-ico">${icone('navigation')}</span>
            <div>
              <span class="deck-num">Deck ${t.deck} · ${tempo(t.seg)}</span>
              <h3>${titulo}</h3>
              <p class="small">${alvo}${dica}</p>
            </div>
          </div>
          <div class="gps-mapa" data-gps-mapa="${i}"><p class="small muted planta-msg">${T.carregandoPlanta}</p></div>
          <div class="planta-topo gps-mapa-base">
            <p class="small muted">${T.proaParaCima}</p>
            <button type="button" class="btn btn-sm btn-ghost" data-gps-ampliar="${i}">${icone('search')} ${T.ampliar}</button>
          </div>
        </li>`;
      });
      html.push(`<li class="card gps-passo gps-chegada">
        <div class="gps-passo-cab">
          <span class="gps-passo-ico">${icone('pin')}</span>
          <div>
            <span class="deck-num">Deck ${para.deck} · ${T.chegada}</span>
            <h3>${esc(favDe(para) ? `${favDe(para)!.n} · ${para.nome}` : para.nome)}</h3>
            ${para.texto ? `<p class="small">${esc(para.texto)}</p>` : ''}
          </div>
        </div>
      </li>`);
      passos.innerHTML = html.join('');
      resultado.hidden = false;
      desenharPerfil(troca.length > 0);
      andando.forEach(montarMapa);
    }

    // ---- Vista lateral: o caminho no navio inteiro ----
    const pf = $<SVGSVGElement>('.gps-resumo .perfil-svg');
    const faixa = (deck: number) => {
      const r = pf.querySelector(`[data-pf="${deck}"] rect`)!;
      const v = (k: string) => Number(r.getAttribute(k));
      return { x: v('x'), y: v('y'), w: v('width'), h: v('height') };
    };
    // No desenho, o casco vai de x = 12 (popa) a x = 386 (proa), para os 3.765 px da planta mais longa.
    const xPerfil = (deck: number, y: number) => {
      const f = faixa(deck);
      const x = 12 + ((dados!.decks[deck].h - y) / 3765) * 374;
      return Math.max(f.x + 6, Math.min(f.x + f.w - 18, x));
    };

    function desenharPerfil(trocaDeck: boolean) {
      const { de, para } = pontos as Record<Campo, Ponto>;
      pf.querySelectorAll('.pf-deck').forEach((g) => g.classList.toggle('ativo', [de.deck, para.deck].includes(Number((g as SVGElement).dataset.pf))));
      const pts: [number, number][] = [];
      const meio = (deck: number) => {
        const f = faixa(deck);
        return f.y + f.h / 2;
      };
      for (const t of rota!.trechos) {
        if (t.tipo === 'andar') {
          pts.push([xPerfil(t.deck, t.pts[0][1]), meio(t.deck)], [xPerfil(t.deck, t.pts[t.pts.length - 1][1]), meio(t.deck)]);
        } else {
          const c = dados!.decks[t.de].b[t.banco]!;
          const x = pts.length ? pts[pts.length - 1][0] : xPerfil(t.de, (c[1] + 0.5) * dados!.cell);
          pts.push([x, meio(t.de)], [x, meio(t.ate)]);
        }
      }
      const d = 'M' + pts.map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join('L');
      const [a, b] = [pts[0], pts[pts.length - 1]];
      // no mesmo deck, A e B podem ficar colados: afasta um pouco para os dois aparecerem
      if (!trocaDeck && Math.abs(a[0] - b[0]) < 13) b[0] = a[0] + (b[0] >= a[0] ? 13 : -13);
      const marca = (p: [number, number], letra: string) =>
        `<g class="pf-m pf-m-${letra.toLowerCase()}" transform="translate(${p[0].toFixed(1)} ${p[1].toFixed(1)})"><circle r="6.2"/><text>${letra}</text></g>`;
      pf.querySelector('.pf-rota')!.innerHTML = `<path class="pf-halo" d="${d}"/><path d="${d}"/>${marca(a, 'A')}${marca(b, 'B')}`;
    }

    // ---- Planta de cada trecho a pé ----
    /** Recorte da planta em volta do trecho: [x, y, largura, altura]. */
    const enquadrar = (t: Andar) => {
      const d = dados!.decks[t.deck];
      const xs = t.pts.map((p) => p[0]);
      const ys = t.pts.map((p) => p[1]);
      const M = 85;
      const y0 = Math.max(-12, Math.min(...ys) - M);
      const y1 = Math.min(d.h + 12, Math.max(...ys) + M);
      const h = y1 - y0;
      // largura: o trecho com folga, no mínimo 300; trechos compridos abrem até a largura do navio (ou mais)
      let w = Math.max(300, Math.max(...xs) - Math.min(...xs) + 2 * M);
      if (h / w > 1.5) w = Math.min(d.w + 24, h / 1.5);
      if (h / w > 2.6) w = h / 2.6;
      let x0 = (Math.min(...xs) + Math.max(...xs)) / 2 - w / 2;
      x0 = w >= d.w + 24 ? (d.w - w) / 2 : Math.max(-12, Math.min(d.w + 12 - w, x0));
      return [x0, y0, w, h].map(Math.round);
    };

    /** Desenha a linha e os marcadores de um trecho por cima da planta. `largura` = largura do SVG na tela. */
    function tracar(el: SVGSVGElement, t: Andar, largura: number) {
      el.querySelector('.gps-tracado')?.remove();
      const u = el.viewBox.baseVal.width / Math.max(1, largura); // unidades da planta por pixel da tela
      const d = 'M' + t.pts.map((p) => p.join(' ')).join('L');
      const marca = (p: [number, number], tipo: 'a' | 'b' | 'e') =>
        `<g class="gps-m gps-m-${tipo}" transform="translate(${p[0]} ${p[1]})"><circle r="${(12 * u).toFixed(2)}"/>` +
        (tipo === 'e'
          ? `<g class="gps-m-ico" transform="scale(${(0.66 * u).toFixed(3)}) translate(-12 -12)">${ICONS.elevator}</g>`
          : `<text font-size="${(13 * u).toFixed(2)}">${tipo.toUpperCase()}</text>`) +
        '</g>';
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'gps-tracado');
      g.innerHTML =
        `<path class="gps-l0" d="${d}"/><path class="gps-l1" d="${d}"/><path class="gps-l2" d="${d}"/>` +
        marca(t.pts[0], rota!.trechos[0] === t ? 'a' : 'e') +
        marca(t.pts[t.pts.length - 1], t.ate === 'destino' ? 'b' : 'e');
      el.append(g);
    }

    const destacar = (el: SVGSVGElement, p: Ponto) => {
      if (p.cabine) el.querySelector(`[data-cabine="${p.cabine}"]`)?.classList.add('achada');
      for (const id of p.ids ?? []) el.querySelectorAll(`[data-lugar="${id}"], [data-porta="${id}"]`).forEach((s) => s.classList.add('ativo'));
    };

    async function montarMapa(t: Andar, i: number) {
      const atual = rota;
      const box = passos.querySelector<HTMLElement>(`[data-gps-mapa="${i}"]`)!;
      try {
        const txt = await planta(t.deck);
        if (rota !== atual) return; // a rota mudou enquanto a planta carregava
        box.innerHTML = txt;
        const el = box.querySelector('svg')!;
        el.setAttribute('viewBox', enquadrar(t).join(' '));
        el.setAttribute('aria-label', T.plantaAria(t.deck));
        const { de, para } = pontos as Record<Campo, Ponto>;
        if (de.deck === t.deck) destacar(el, de);
        if (para.deck === t.deck) destacar(el, para);
        tracar(el, t, box.clientWidth);
      } catch {
        box.innerHTML = `<p class="small muted planta-msg">${T.erroPlanta}</p>`;
      }
    }

    // ---- Ampliar: a planta inteira do deck, com zoom ----
    const zoomDlg = $<HTMLDialogElement>('.gps-zoom');
    const area = zoomDlg.querySelector<HTMLElement>('.pr-area')!;
    const zSvg = zoomDlg.querySelector<HTMLElement>('.pr-svg')!;
    let zTrecho: Andar | null = null;
    const retracar = () => {
      const el = zSvg.querySelector('svg');
      if (el && zTrecho) tracar(el, zTrecho, zSvg.clientWidth);
    };
    const zoom = criarZoom(area, { alvo: () => zSvg, base: () => Math.min(area.clientWidth, 760), aoMudar: retracar });

    /** Zoom e posição para o trecho inteiro caber na tela (ou, se for comprido demais, mostrar o começo). */
    const verRota = () => {
      if (!zTrecho || !dados) return;
      const t = zTrecho;
      const d = dados.decks[t.deck];
      const xs = t.pts.map((p) => p[0]);
      const ys = t.pts.map((p) => p[1]);
      const bw = Math.max(...xs) - Math.min(...xs) + 170;
      const bh = Math.max(...ys) - Math.min(...ys) + 170;
      const base = Math.min(area.clientWidth, 760);
      zoom.reiniciar();
      zoom.aplicar(Math.min(d.w / bw, (area.clientHeight * d.w) / (base * bh), 4));
      const f = zSvg.clientWidth / d.w;
      const cabe = bh * f <= area.clientHeight;
      const cy = cabe ? (Math.min(...ys) + Math.max(...ys)) / 2 : t.pts[0][1];
      area.scrollTo((zSvg.offsetLeft + ((Math.min(...xs) + Math.max(...xs)) / 2) * f) - area.clientWidth / 2, cy * f - area.clientHeight / 2);
    };

    const ampliar = (i: number) => {
      if (!rota || !dados) return;
      const t = rota.trechos.filter((x): x is Andar => x.tipo === 'andar')[i];
      const origem = passos.querySelector<SVGSVGElement>(`[data-gps-mapa="${i}"] svg`);
      if (!t || !origem) return;
      const d = dados.decks[t.deck];
      const el = origem.cloneNode(true) as SVGSVGElement;
      el.setAttribute('viewBox', `0 0 ${d.w} ${d.h}`);
      zSvg.style.aspectRatio = `${d.w} / ${d.h}`;
      zSvg.replaceChildren(el);
      zTrecho = t;
      zoomDlg.querySelector('#gps-zoom-titulo')!.textContent = `Deck ${t.deck}`;
      zoomDlg.showModal();
      verRota();
    };

    zoomDlg.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-gps-zoom]');
      if (!b) return;
      const k = Number(b.dataset.gpsZoom);
      if (k === 0) verRota();
      else zoom.aplicar(zoom.valor * (k > 0 ? 1.5 : 1 / 1.5));
    });

    // ---- Escolher um ponto ----
    const item = (p: Ponto, sub?: string, nome?: string) =>
      `<li><button type="button" class="lugar-item" data-gps-item="${esc(p.chave)}">
        <span class="lugar-cor" data-cat="${esc(p.cat)}">${icone(cats[p.cat]?.icone ?? 'pin')}</span>
        <span class="lugar-item-txt"><b>${esc(nome ?? p.nome)}</b><small>${esc(sub ?? T.deckCat(p.deck, cats[p.cat]?.nome ?? ''))}</small></span>
      </button></li>`;
    const grupo = (titulo: string, itens: string[]) => (itens.length ? `<h4 class="lbl">${esc(titulo)}</h4><ul>${itens.join('')}</ul>` : '');
    const vazio = (t: string) => `<p class="small muted gps-vazio">${esc(t)}</p>`;

    function listar() {
      if (!dados) {
        lista.innerHTML = vazio(T.carregandoLugares);
        return;
      }
      const q = semAcento(busca.value.trim());
      // favoritos no topo (a busca também acha pelo nome dado, como "mãe")
      const meus =
        campoAberto === 'fav'
          ? ''
          : grupo(
              T.favoritos,
              favs
                .filter((f) => !q || semAcento(`${f.n} ${f.p} ${f.k.slice(1)}`).includes(q))
                .flatMap((f) => {
                  const p = porChave(f.k);
                  return p ? [item(p, `${p.nome} · deck ${p.deck}`, f.n)] : [];
                }),
            );
      if (/^\d+$/.test(q)) {
        const c = q.length >= 4 ? cabine(dados, Number(q)) : null;
        lista.innerHTML = c
          ? meus + grupo(T.cabineLbl, [item(c, T.deckCabine(c.deck))])
          : meus || vazio(q.length >= 4 ? T.naoAchei(q) : T.digiteNumero);
        return;
      }
      const achados = dados.lugares.filter((l) => !q || semAcento(`${l.n} ${l.o ?? ''} ${cats[l.c]?.nome ?? ''} ${l.t} deck ${l.d}`).includes(q));
      const minha = !q && guardada() && !favs.some((f) => f.k === `c${guardada()}`) ? cabine(dados, guardada()) : null;
      const html =
        meus +
        (minha ? grupo(T.minhaCabine, [item(minha, T.ultimaCabine(minha.deck))]) : '') +
        ORDEM.map((c) =>
          grupo(
            cats[c].nome,
            achados.filter((l) => l.c === c).sort((a, b) => a.n.localeCompare(b.n, T.locale) || a.d - b.d).map((l) => item(lugar(l))),
          ),
        ).join('');
      lista.innerHTML = html || vazio(T.nadaAchado);
    }

    const abrirPicker = async (campo: Escolha) => {
      campoAberto = campo;
      const letra = picker.querySelector<HTMLElement>('.gps-letra')!;
      if (campo === 'fav') letra.innerHTML = icone('star');
      else letra.textContent = campo === 'de' ? 'A' : 'B';
      letra.classList.toggle('b', campo !== 'de');
      picker.querySelector('#gps-picker-titulo')!.textContent =
        campo === 'de' ? T.tituloDe : campo === 'para' ? T.tituloPara : T.tituloFav;
      busca.value = '';
      listar();
      picker.showModal();
      lista.scrollTop = 0;
      if (!dados && (await carregar())) listar();
    };

    busca.addEventListener('input', listar);
    picker.addEventListener('click', (e) => {
      if (e.target === picker) picker.close();
      const b = (e.target as Element).closest<HTMLElement>('[data-gps-item]');
      if (!b) return;
      picker.close();
      const p = porChave(b.dataset.gpsItem!);
      if (campoAberto === 'fav') escolherFav(p);
      else definir(campoAberto, p);
    });

    root.addEventListener('click', async (e) => {
      const alvo = e.target as Element;
      const campo = alvo.closest<HTMLElement>('[data-gps-campo]');
      if (campo) return abrirPicker(campo.dataset.gpsCampo as Campo);
      if (alvo.closest('[data-gps-trocar]')) {
        [pontos.de, pontos.para] = [pontos.para, pontos.de];
        mostrarCampo('de');
        mostrarCampo('para');
        return calcular();
      }
      const atalho = alvo.closest<HTMLElement>('[data-gps-atalho]');
      if (atalho && (await carregar())) {
        const l = dados!.lugares.find((x) => x.n.startsWith(atalho.dataset.gpsAtalho!));
        if (l) ir(l.id);
        return;
      }
      const fav = alvo.closest<HTMLElement>('[data-gps-fav]');
      if (fav && (await carregar())) {
        const f = favs[Number(fav.dataset.gpsFav)];
        if (f) ir(f.k);
        return;
      }
      if (alvo.closest('[data-gps-favs-abrir]')) return abrirFavs();
      const amp = alvo.closest<HTMLElement>('[data-gps-ampliar]');
      if (amp) ampliar(Number(amp.dataset.gpsAmpliar));
    });

    // ---- Favoritos: atalhos no formulário e janela para editar ----
    const favLista = $('[data-gps-favs-lista]');
    const favNota = $('.gps-favs-nota');
    const favDlg = $<HTMLDialogElement>('.gps-favs-dlg');
    const favItens = favDlg.querySelector<HTMLElement>('.gps-favs-itens')!;
    const favForm = favDlg.querySelector<HTMLFormElement>('.gps-fav-form')!;
    const favNome = favForm.querySelector<HTMLInputElement>('input')!;
    const favPontoBtn = favForm.querySelector<HTMLElement>('[data-gps-fav-ponto]')!;
    const favErro = favForm.querySelector<HTMLElement>('.gps-fav-erro')!;
    let favPonto: Ponto | null = null;
    let favEditando = -1;

    function mostrarFavs() {
      const sub = (f: Fav) => (/^c\d+$/.test(f.k) ? f.k.slice(1) : `deck ${f.d}`);
      favLista.innerHTML =
        favs
          .map(
            (f, i) =>
              `<button type="button" class="gps-chip gps-chip-fav" data-gps-fav="${i}" title="${esc(`${f.n}: ${ondeFav(f)}`)}">` +
              `<span>${esc(f.n)}</span><small>${esc(sub(f))}</small></button>`,
          )
          .join('') +
        `<button type="button" class="gps-chip gps-chip-novo" data-gps-favs-abrir>${icone('plus')} ${
          favs.length ? T.adicionar : T.salvarFamilia
        }</button>`;
      $('.gps-favs-topo [data-gps-favs-abrir]').hidden = !favs.length;
      favItens.innerHTML = favs
        .map(
          (f, i) => `<li class="gps-fav-linha">
            <button type="button" class="lugar-item" data-gps-fav-editar="${i}">
              <span class="lugar-cor gps-fav-ico">${icone(/^c\d+$/.test(f.k) ? 'bed' : 'pin')}</span>
              <span class="lugar-item-txt"><b>${esc(f.n)}</b><small>${esc(`${ondeFav(f)} · deck ${f.d}`)}</small></span>
              <span class="gps-link">${T.editar}</span>
            </button>
            <button type="button" class="gps-fav-apagar" data-gps-fav-apagar="${i}" aria-label="${esc(T.apagar(f.n))}">${icone('trash')}</button>
          </li>`,
        )
        .join('');
      favItens.hidden = !favs.length;
      favDlg.querySelector<HTMLElement>('[data-gps-favs-enviar]')!.hidden = !favs.length;
      favDlg.querySelector<HTMLElement>('.gps-fav-enviar-nota')!.hidden = !favs.length;
      // os nomes também aparecem nos campos A e B
      mostrarCampo('de');
      mostrarCampo('para');
    }

    const mostrarFavPonto = () => {
      favPontoBtn.classList.toggle('vazio', !favPonto);
      favPontoBtn.querySelector('small')!.textContent = favPonto ? T.deckTrocar(favPonto.deck) : T.toqueEscolher;
      favPontoBtn.querySelector('b')!.textContent = favPonto ? favPonto.nome : T.digiteCabine;
    };

    const prepararForm = (i = -1) => {
      favEditando = i;
      const f = favs[i];
      favNome.value = f?.n ?? '';
      favPonto = f ? porChave(f.k) : null;
      favErro.textContent = '';
      favForm.querySelector('.gps-fav-form-titulo')!.textContent = f ? T.editarNome(f.n) : T.novoFavorito;
      favForm.querySelector<HTMLElement>('[data-gps-fav-cancelar]')!.hidden = !f;
      mostrarFavPonto();
    };

    function escolherFav(p: Ponto | null) {
      favPonto = p;
      favErro.textContent = '';
      mostrarFavPonto();
      if (!favNome.value.trim()) favNome.focus();
    }

    async function abrirFavs() {
      favNota.textContent = '';
      prepararForm();
      mostrarFavs();
      favDlg.showModal();
      favDlg.querySelector<HTMLElement>('.gps-favs-corpo')!.scrollTop = 0;
      await carregar();
    }

    favForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const n = limparNome(favNome.value);
      if (!n) {
        favErro.textContent = T.escrevaNome;
        return favNome.focus();
      }
      if (!favPonto) {
        favErro.textContent = T.escolhaLugar;
        return;
      }
      const f: Fav = { n, k: favPonto.chave, p: favPonto.nome, d: favPonto.deck };
      if (favEditando >= 0 && favs[favEditando]) favs[favEditando] = f;
      else if (favs.length >= MAX_FAVS) {
        favErro.textContent = T.maxFavs(MAX_FAVS);
        return;
      } else favs.push(f);
      salvarFavs();
      prepararForm();
    });

    favDlg.addEventListener('click', async (e) => {
      const alvo = e.target as Element;
      if (alvo === favDlg) return favDlg.close();
      if (alvo.closest('[data-gps-fav-ponto]')) return abrirPicker('fav');
      if (alvo.closest('[data-gps-fav-cancelar]')) return prepararForm();
      const ed = alvo.closest<HTMLElement>('[data-gps-fav-editar]');
      if (ed) {
        await carregar();
        prepararForm(Number(ed.dataset.gpsFavEditar));
        favForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return favNome.focus();
      }
      const ap = alvo.closest<HTMLElement>('[data-gps-fav-apagar]');
      if (ap) {
        const i = Number(ap.dataset.gpsFavApagar);
        if (!favs[i] || !confirm(T.confirmarApagar(favs[i].n))) return;
        favs.splice(i, 1);
        if (favEditando === i) prepararForm();
        else if (favEditando > i) favEditando--;
        return salvarFavs();
      }
      if (alvo.closest('[data-gps-favs-enviar]')) return enviarFavs();
    });

    /** Link para esta página com os favoritos (fav=Nome~chave): quem abrir recebe os mesmos nomes. */
    async function enviarFavs() {
      const u = new URL(location.pathname, location.origin);
      for (const f of favs) u.searchParams.append('fav', `${f.n}~${f.k}`);
      const texto = T.textoEnvio(favs.map((f) => `${f.n} (${ondeFav(f).toLowerCase()})`).join(', '));
      const nota = favDlg.querySelector<HTMLElement>('.gps-fav-enviar-nota')!;
      try {
        if (navigator.share) return await navigator.share({ title: T.tituloEnvio, text: texto, url: u.href });
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
      }
      try {
        await navigator.clipboard.writeText(`${texto} ${u.href}`);
        nota.textContent = T.linkCopiado;
      } catch {
        prompt(T.copieLink, u.href);
      }
    }

    /** Recebe os favoritos de um link enviado por alguém (?fav=Nome~chave). */
    function receberFavs() {
      const u = new URL(location.href);
      const vindos = u.searchParams.getAll('fav');
      if (!vindos.length) return;
      u.searchParams.delete('fav');
      history.replaceState(null, '', u);
      let novos = 0;
      for (const v of vindos) {
        const corte = v.lastIndexOf('~');
        const n = limparNome(v.slice(0, corte));
        const p = corte > 0 ? porChave(v.slice(corte + 1)) : null;
        if (!n || !p || favs.length >= MAX_FAVS || favs.some((f) => f.n === n && f.k === p.chave)) continue;
        favs.push({ n, k: p.chave, p: p.nome, d: p.deck });
        novos++;
      }
      if (novos) salvarFavs();
      favNota.textContent = novos ? T.recebidos(novos) : T.jaSalvos;
    }

    /** Define o destino; sem ponto de partida, pede um. */
    const ir = (chave: string) => {
      const p = porChave(chave);
      if (!p) return;
      definir('para', p);
      if (!pontos.de) abrirPicker('de');
      else root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // as plantas mudam de escala quando a tela muda de tamanho: refaz os marcadores
    let espera = 0;
    window.addEventListener('resize', () => {
      clearTimeout(espera);
      espera = window.setTimeout(() => {
        if (!rota) return;
        const andando = rota.trechos.filter((t): t is Andar => t.tipo === 'andar');
        andando.forEach((t, i) => {
          const box = passos.querySelector<HTMLElement>(`[data-gps-mapa="${i}"]`);
          const el = box?.querySelector('svg');
          if (box && el) tracar(el, t, box.clientWidth);
        });
      }, 150);
    });

    mostrarFavs();
    carregar().then((d) => {
      if (!d) return;
      ponte.tem = (chave) => !!porChave(chave);
      ponte.ir = ir;
      receberFavs();
      const q = new URLSearchParams(location.search);
      pontos.de = porChave(q.get('de') ?? '') ?? (guardada() ? cabine(d, guardada()) : null);
      pontos.para = porChave(q.get('para') ?? '');
      mostrarCampo('de');
      mostrarCampo('para');
      if (pontos.de && pontos.para) calcular();
    });
  }
</script>
