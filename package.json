{
  "name": "virtuosa-gps",
  "version": "0.2.0",
  "description": "Indoor walking GPS for the MSC Virtuosa cruise ship, plus a 3D model of the ship at sea: redrawn deck plans, route data, a bilingual (EN/PT-BR) Astro component and a three.js scene. Works offline.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "3d",
    "astro-component",
    "cruise",
    "deck-plan",
    "indoor-navigation",
    "msc-virtuosa",
    "threejs",
    "wayfinding",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicius741/virtuosa-gps.git"
  },
  "homepage": "https://virtuosa-gps.vinicius741.workers.dev",
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    "./Gps.astro": "./src/gps/Gps.astro",
    "./ShipProfile.astro": "./src/gps/ShipProfile.astro",
    "./styles.css": "./src/gps/styles.css",
    "./rotas": "./src/gps/lib/rotas.ts",
    "./zoom": "./src/gps/lib/zoom.ts",
    "./icons": "./src/gps/lib/icons.ts",
    "./strings": "./src/gps/i18n/strings.ts",
    "./integration": "./integration.mjs",
    "./data/*": "./public/plantas/*",
    "./ship3d": "./ship3d/src/index.ts",
    "./ship3d/texts": "./ship3d/src/ui/texts.ts"
  },
  "files": [
    "src/gps",
    "public/plantas",
    "ship3d/src",
    "integration.mjs",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "astro": ">=5",
    "three": ">=0.170"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-sw.mjs",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && node scripts/check-i18n.mjs && tsc -p ship3d",
    "deploy": "npm run build && wrangler deploy",
    "dev:3d": "vite --config ship3d/vite.config.ts",
    "build:3d": "tsc -p ship3d && vite build --config ship3d/vite.config.ts",
    "preview:3d": "npm run build:3d && wrangler dev --config ship3d/wrangler.jsonc",
    "deploy:3d": "npm run build:3d && wrangler deploy --config ship3d/wrangler.jsonc",
    "data:3d": "node ship3d/scripts/extract-plans.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.187.0",
    "astro": "7.4.7",
    "three": "^0.187.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "wrangler": "4.158.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
