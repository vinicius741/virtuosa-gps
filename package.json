{
  "name": "virtuosa-gps",
  "version": "0.1.0",
  "description": "Indoor walking GPS for the MSC Virtuosa cruise ship: redrawn deck plans, route data and a bilingual (EN/PT-BR) Astro component. Works offline.",
  "license": "MIT",
  "type": "module",
  "keywords": ["astro-component", "cruise", "msc-virtuosa", "indoor-navigation", "deck-plan", "wayfinding"],
  "repository": { "type": "git", "url": "git+https://github.com/vinicius741/virtuosa-gps.git" },
  "homepage": "https://virtuosa-gps.vinicius741.workers.dev",
  "engines": { "node": ">=22.23.4" },
  "exports": {
    "./Gps.astro": "./src/gps/Gps.astro",
    "./ShipProfile.astro": "./src/gps/ShipProfile.astro",
    "./styles.css": "./src/gps/styles.css",
    "./rotas": "./src/gps/lib/rotas.ts",
    "./zoom": "./src/gps/lib/zoom.ts",
    "./icons": "./src/gps/lib/icons.ts",
    "./strings": "./src/gps/i18n/strings.ts",
    "./integration": "./integration.mjs",
    "./data/*": "./public/plantas/*"
  },
  "files": ["src/gps", "public/plantas", "integration.mjs", "LICENSE", "README.md"],
  "peerDependencies": { "astro": ">=5" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-sw.mjs",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && node scripts/check-i18n.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "7.4.7",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  }
}
